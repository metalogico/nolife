APP_NAME=NoLife
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8093
APP_TIMEZONE=Europe/Rome
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

DB_CONNECTION=sqlite
DB_FOREIGN_KEYS=true
# DB_DATABASE=/absolute/path/to/database.sqlite
SESSION_DRIVER=file
SESSION_COOKIE=sh_nolife_session
SESSION_LIFETIME=10080
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

# Generate the quoted hash line with the Docker command in README.md.
NOLIFE_USERNAME=replace-with-your-username
NOLIFE_PASSWORD_HASH='replace-with-bcrypt-hash'

IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# MCP is managed in Settings in the web interface; no environment edits are needed.
# Optional legacy defaults, used only until the first change in Settings:
# NOLIFE_MCP_ENABLED=false
# NOLIFE_MCP_READ_TOKEN_HASH=
# NOLIFE_MCP_WRITE_TOKEN_HASH=

NOLIFE_BIND_IP=127.0.0.1
NOLIFE_PORT=8093
NOLIFE_URL=http://localhost:8093

# Use latest from main, or pin sha-<full commit> for controlled updates.
NOLIFE_IMAGE=ghcr.io/metalogico/nolife:latest

# Advanced: isolate an additional installation (see docs/installation.md).
# NOLIFE_ENV_FILE=/absolute/path/to/another.env
